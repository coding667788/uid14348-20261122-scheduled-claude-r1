{
  "case_version": 1,
  "name": "golden-path-two-proxies",
  "description": "Two proxies on one fault domain. A generation-1 request enters at px-a, is rewritten from L0 to L1 and delivered to svc-orders. New inbound version v2 is installed at px-b, the old generation is drained, the barrier proves it, and v1 is retired. No pause is needed.",
  "ttl": 6,
  "horizon": 30,
  "tenants": [
    "t-alpha",
    "t-beta"
  ],
  "services": [
    {
      "id": "svc-orders",
      "accepts": [
        {
          "tenant": "t-alpha",
          "label": "L1"
        },
        {
          "tenant": "t-beta",
          "label": "L1"
        }
      ]
    }
  ],
  "nodes": [
    {
      "id": "px-a",
      "kind": "proxy",
      "region": "r1"
    },
    {
      "id": "px-b",
      "kind": "proxy",
      "region": "r2"
    },
    {
      "id": "svc-node",
      "kind": "service",
      "region": "r2",
      "service": "svc-orders"
    }
  ],
  "links": [
    {
      "id": "a-b",
      "from": "px-a",
      "to": "px-b",
      "delivery": 1,
      "forward": 0,
      "domain": "d-east"
    },
    {
      "id": "b-s",
      "from": "px-b",
      "to": "svc-node",
      "delivery": 0,
      "forward": 0,
      "domain": "d-east"
    }
  ],
  "identities": [
