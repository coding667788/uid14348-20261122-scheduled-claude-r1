        "service": "svc-orders",
        "identity": "id-alpha",
        "label": "L1"
      }
    ],
    "egress": [
      {
        "id": "eg-a-v1",
        "version": "v1",
        "proxy": "px-a",
        "generation": 1,
        "tenant": "t-alpha",
        "service": "svc-orders",
        "identity": "id-alpha",
        "label_in": "L0",
        "label_out": "L1",
        "link": "a-b"
      },
      {
        "id": "eg-b-v1",
        "version": "v1",
        "proxy": "px-b",
        "generation": 1,
        "tenant": "t-alpha",
        "service": "svc-orders",
        "identity": "id-alpha",
        "label_in": "L1",
        "label_out": "L1",
        "link": "b-s"
